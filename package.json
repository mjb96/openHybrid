{
  "name": "openhybrid",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "test": "node --test",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc -p jsconfig.json",
    "precache:gen": "node scripts/gen-precache.mjs",
    "icons:gen": "node scripts/generate-icons.mjs",
    "precache:check": "node scripts/gen-precache.mjs --check",
    "browser:verify": "node scripts/run-browser-checks.mjs",
    "perf:baseline": "node scripts/performance-baseline.mjs",
    "workflow:check": "node scripts/verify-workflow-gates.mjs",
    "vendor:fit": "node scripts/vendor-fit.mjs",
    "verify": "npm run typecheck && npm run precache:check && npm run workflow:check && npm test && npm run smoke",
    "preflight": "npm run verify && npm run browser:verify"
  },
  "devDependencies": {
    "@sentry/browser": "8.55.2",
    "buffer": "^6.0.3",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.8",
    "fit-file-parser": "^3.1.3",
    "jsdom": "^26.1.0",
    "leaflet": "1.9.4",
    "playwright": "1.65.1",
    "typescript": "^6.0.3"
  }
}
